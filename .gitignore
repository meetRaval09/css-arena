# Local configuration — holds the admin hash and the render secret
config.php

# Everything the running system produces
storage/designs/*
storage/render/*
storage/shots/*
storage/logs/*
!storage/**/.gitkeep

# Rendered round targets are generated by the organiser, not source
assets/rounds/*
!assets/rounds/.gitkeep

# Test artefacts
tests/*.sqlite
tests/*.sqlite-*
tests/*.png
tests/*.xlsx
node_modules/
package-lock.json

# Setup-time diagnostics, deleted before an event
spike.php
diag*.php
admin/designs_old.php

# OS noise
.DS_Store
Thumbs.db
desktop.ini
